# Copia este archivo a .env y ajusta los valores.

# URL del registro de anuncios publicado en Cloudflare Pages (ver /ads en el repo).
# Si se omite, la app no consulta la red y usa solo el registro empaquetado.
EXPO_PUBLIC_ADS_REGISTRY_URL=https://narra-ads.pages.dev/registry.json

# Base URL for web workers (empty for development, /narra for GitHub Pages)
EXPO_PUBLIC_BASE_URL=

# AdMob (react-native-google-mobile-ads). Los App IDs van en app.json (plugin
# react-native-google-mobile-ads); los de abajo son unit IDs de los anuncios a
# pantalla completa. En dev siempre se usan los TestIds de Google; en
# produccion, si se omiten, tambien se usan los TestIds (nunca rompe).
EXPO_PUBLIC_ADMOB_INTERSTITIAL_ID=
EXPO_PUBLIC_ADMOB_REWARDED_ID=
