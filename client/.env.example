# Copia este archivo a .env y ajusta los valores.

# URL del Worker de Cloudflare (ver /worker en el repo): un solo worker sirve
# tanto el registro de anuncios (esta misma URL, sin query) como el
# manifiesto y contenido de las listas por defecto
# (?defaultLists=manifest / ?defaultLists=<id>). Si se omite, la app no
# consulta la red y usa solo lo empaquetado localmente (registro de anuncios
# vacío, listas por defecto de data/default-lists).
EXPO_PUBLIC_ADS_REGISTRY_URL=https://narra-json-api.example.workers.dev/

# Base URL for web workers (empty for development, /narra for GitHub Pages)
EXPO_PUBLIC_BASE_URL=

# AdMob (react-native-google-mobile-ads). Los App IDs van en app.json (plugin
# react-native-google-mobile-ads); los de abajo son unit IDs de los anuncios a
# pantalla completa. En dev siempre se usan los TestIds de Google; en
# produccion, si se omiten, tambien se usan los TestIds (nunca rompe).
EXPO_PUBLIC_ADMOB_INTERSTITIAL_ID=
EXPO_PUBLIC_ADMOB_REWARDED_ID=
